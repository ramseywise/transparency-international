# Python environment and caches (all rebuilt automatically)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Secrets and personal settings
.env
.env.*
.claude/settings.local.json

# Operating system and editor files
.DS_Store
.vscode/
.idea/

# The literature library's data (literature/<study>/data/raw and data/processed)
# IS in git since 2026-11-25, so that the MCP server can search it from any
# machine. Only material that is not public stays out: see literature/README.md,
# "What is in git".
literature/*/data/private/

# Participant lists: they name individual people. The source is public and
# named in the study's docs; the scripts rebuild the derived table from it.
unfccc/docs/archived/
unfccc/data/
unfccc/notebooks/
unfccc/outputs/

# Raw eval answers: scratch. The scores are kept in .claude/skills/run-evals/results.md.
.claude/skills/run-evals/runs/
